# givepad — every variable here is unset on purpose.
#
# Nothing is deployed. Each of these turns one honest "awaiting launch" into a
# real value; none of them has a placeholder, because an address that looks
# deployed is worse than a blank — somebody will send funds to it.

# The public origin, used for metadata and the api's self-links.
NEXT_PUBLIC_GIVEPAD_URL=https://givepad.tech

# The indexer. While unset, the tables render the example set in
# src/lib/tokens.ts and say so, and the site total in src/lib/given.ts reads
# zero rather than inventing a donation figure.
NEXT_PUBLIC_GIVEPAD_API=

# Contracts on Robinhood Chain. See src/lib/contracts.ts.
#   FACTORY  — deploys a token on Pons V2 and writes its cause split
#   SPLITTER — immutable recipient, no owner, no withdraw, open release()
#   REGISTRY — cause slug -> the payout address donate.gg verified
#   TOKEN    — the house token
NEXT_PUBLIC_GIVEPAD_FACTORY=
NEXT_PUBLIC_GIVEPAD_SPLITTER=
NEXT_PUBLIC_GIVEPAD_REGISTRY=
NEXT_PUBLIC_GIVEPAD_TOKEN=

# An RPC for reading the chain from the server.
GIVEPAD_RPC_URL=
